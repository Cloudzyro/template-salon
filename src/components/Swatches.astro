---
// The hero's one rich moment: a colorist's swatch ring, strands of hair in the
// shades the salon works with, hanging from a brass bar. Drawn in SVG.
const shades = [
  "#1f1714", "#2a1d18", "#3b2a22", "#4a3128", "#5a3a2e", "#6b4a3a", "#7a5640", "#8c3b2c",
  "#a14a33", "#b5603f", "#c4774b", "#b98a55", "#cfa069", "#d9b27c", "#e3c08a", "#ead3a6",
  "#efe0c2", "#dedad3", "#b9b5af", "#8d8a86", "#a35a55", "#c98b84", "#e5b7ae", "#6f7d5c",
];
const W = 1600;
const gap = W / (shades.length + 1);
const strands = shades.map((c, i) => {
  const x = gap * (i + 1);
  const len = 250 + ((i * 53) % 90);
  const sway = ((i * 29) % 17) - 8;
  return { c, x, len, sway };
});
---

<svg class="swatches" viewBox="0 0 1600 380" preserveAspectRatio="xMidYMin slice" role="img" aria-label="A colorist's swatch ring: twenty-four strands of hair hanging in a row, from near black through browns, copper and honey blonde to silver, rose and sage">
  <rect x="24" y="22" width="1552" height="10" rx="5" fill="#b48a52"></rect>
  <rect x="24" y="22" width="1552" height="3" rx="1.5" fill="#d6b47e"></rect>
  {
    strands.map((s) => (
      <g>
        <rect x={s.x - 9} y="18" width="18" height="18" rx="4" fill="#8a6a3c"></rect>
        <path
          d={`M${s.x - 14} 34 C${s.x - 15} ${34 + s.len * 0.4} ${s.x - 12 + s.sway} ${34 + s.len * 0.75} ${s.x - 7 + s.sway} ${34 + s.len} L${s.x + 7 + s.sway} ${34 + s.len} C${s.x + 12 + s.sway} ${34 + s.len * 0.75} ${s.x + 15} ${34 + s.len * 0.4} ${s.x + 14} 34 Z`}
          fill={s.c}
        ></path>
        <path d={`M${s.x - 5} 40 C${s.x - 6} ${34 + s.len * 0.5} ${s.x - 2 + s.sway} ${34 + s.len * 0.8} ${s.x + s.sway * 0.9} ${30 + s.len}`} stroke="rgba(255,255,255,0.18)" stroke-width="2" fill="none"></path>
        <path d={`M${s.x + 6} 40 C${s.x + 7} ${34 + s.len * 0.45} ${s.x + 4 + s.sway} ${34 + s.len * 0.8} ${s.x + 2 + s.sway} ${26 + s.len}`} stroke="rgba(0,0,0,0.12)" stroke-width="2" fill="none"></path>
      </g>
    ))
  }
</svg>

<style>
  .swatches {
    width: 100%;
    height: auto;
    min-height: 220px;
  }
</style>
