---
// Sends to PUBLIC_FORM_ENDPOINT (Formspree, Basin, a Supabase function or similar).
// With no endpoint set, the form shows a short note and opens the visitor's email app instead.
import { site } from "../data/site";

interface Props {
  subject: string;
  submitLabel: string;
  thanks: string;
}
const { subject, submitLabel, thanks } = Astro.props;
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? "";
---

<form
  class="cz-form"
  method="post"
  action={endpoint || `mailto:${site.email}`}
  data-endpoint={endpoint}
  data-email={site.email}
  data-subject={subject}
  data-thanks={thanks}
>
  {
    !endpoint && (
      <p class="cz-note" role="note">
        This form isn't connected yet, so sending it opens your email app with your answers filled in. You can also
        write to <a href={`mailto:${site.email}?subject=${encodeURIComponent(subject)}`}>{site.email}</a>
      </p>
    )
  }
  <input type="hidden" name="_subject" value={subject} />
  <slot />
  <div class="cz-actions">
    <button class="btn btn-primary" type="submit">{submitLabel}</button>
    <p class="cz-status" role="status" aria-live="polite"></p>
  </div>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>("form.cz-form").forEach((form) => {
    const status = form.querySelector<HTMLElement>(".cz-status")!;
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const { endpoint, email, subject, thanks } = form.dataset;
      const data = new FormData(form);
      if (!endpoint) {
        const lines: string[] = [];
        for (const [key, value] of data.entries()) {
          if (key.startsWith("_")) continue;
          lines.push(`${key.replace(/_/g, " ")}: ${value}`);
        }
        window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject ?? "")}&body=${encodeURIComponent(lines.join("\n"))}`;
        status.textContent = "Your email app should open with your answers filled in.";
        return;
      }
      const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
      button.disabled = true;
      status.textContent = "Sending...";
      try {
        const res = await fetch(endpoint, { method: "POST", body: data, headers: { Accept: "application/json" } });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        status.textContent = thanks ?? "Thank you, we'll be in touch soon.";
      } catch {
        status.textContent = "";
        status.append("Sorry, that didn't send. Please email ");
        status.append(Object.assign(document.createElement("a"), { href: `mailto:${email}`, textContent: email }));
      } finally {
        button.disabled = false;
      }
    });
  });
</script>

<style>
  .cz-form {
    display: grid;
    gap: 20px;
  }
  .cz-form :global(.field) {
    display: grid;
    gap: 8px;
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .cz-form :global(.field small) {
    font-weight: 400;
    color: var(--muted);
  }
  .cz-form :global(.fields) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
  }
  .cz-form :global(fieldset) {
    border: 0;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 8px;
  }
  .cz-form :global(legend) {
    font-size: 0.9375rem;
    font-weight: 500;
    margin-bottom: 8px;
  }
  .cz-form :global(.choices) {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .cz-form :global(.choice) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: var(--r-control);
    background: var(--field);
    font-weight: 400;
    cursor: pointer;
  }
  .cz-form :global(.choice:has(input:checked)) {
    border-color: var(--ink);
  }
  .cz-form :global(.choice input) {
    accent-color: var(--accent);
    margin: 0;
  }
  .cz-form :global(input:not([type="radio"]):not([type="checkbox"])),
  .cz-form :global(select),
  .cz-form :global(textarea) {
    width: 100%;
    font: inherit;
    font-weight: 400;
    color: var(--ink);
    background: var(--field);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-control);
    padding: 12px 12px;
    min-height: 48px;
  }
  .cz-form :global(:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  .cz-note {
    margin: 0;
    padding: 12px 16px;
    border-radius: var(--r-control);
    background: var(--raised);
    color: var(--ink-2);
    font-size: 0.9375rem;
  }
  .cz-note a {
    color: inherit;
  }
  .cz-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }
  .cz-status {
    margin: 0;
    color: var(--ink-2);
  }
</style>
